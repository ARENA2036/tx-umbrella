meta {
  name: 02-Create Access Policy
  type: http
  seq: 2
}

post {
  url: {{Provider}}/v3/policydefinitions
  body: json
  auth: apikey
}

headers {
  Content-Type: application/json
}

auth:apikey {
  key: X-Api-Key
  value: {{Provider_Api_Key}}
  placement: header
}

body:json {
  {
    "@context": [
      "https://w3id.org/dspace/2025/1/odrl-profile.jsonld",
      "https://w3id.org/catenax/2025/9/policy/context.jsonld",
      {
        "@vocab": "https://w3id.org/edc/v0.0.1/ns/"
      }
    ],
    "@id": "be293-e2e-access-1",
    "@type": "PolicyDefinition",
    "policy": {
      "@type": "Set",
      "permission": [
        {
          "action": "access",
          "constraint": [
            {
              "and": [
                {
                  "leftOperand": "Membership",
                  "operator": "eq",
                  "rightOperand": "active"
                },
                {
                  "leftOperand": "BusinessPartnerNumber",
                  "operator": "isAnyOf",
                  "rightOperand": [
                    "BPNL000000000GUC"
                  ]
                }
              ]
            }
          ]
        }
      ],
      "prohibition": [

      ],
      "obligation": [

      ]
    }
  }
}

tests {
  // 200 + IdResponse on the first run; 409 when the object already exists (re-run): both mean "present".
  test("created (200) or already present (409)", function () {
    expect([200, 409]).to.include(res.getStatus());
  });
  test("IdResponse carries the expected @id", function () {
    if (res.getStatus() === 200) {
      expect(res.getBody()["@id"]).to.equal("be293-e2e-access-1");
    }
  });
}
