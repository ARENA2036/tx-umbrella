meta {
  name: 11 Retrigger BPN credential (approval)
  type: http
  seq: 11
}

post {
  url: {{portalApi}}/registration/application/{{applicationId}}/retrigger-bpn-credential
  body: none
  auth: inherit
}

script:pre-request {
  // CHANGES the application: schedules a new credential request. Approval required, one retrigger at a time.
  const id = bru.getEnvVar("applicationId");
  if (!id || bru.getEnvVar("confirmRetrigger") !== id) {
    throw new Error("Refused: set confirmRetrigger to the applicationId (" + id + ") to send this retrigger");
  }
}

script:post-response {
  bru.setEnvVar("confirmRetrigger", "");
}

assert {
  res.status: eq 204
}

docs {
  Changes state. Only after approval and after the IssuerService cause is fixed; otherwise it fails again.
  Accepted only while BPNL_CREDENTIAL is FAILED and its retrigger step is TODO (credential-status-be293.sh verdict
  RETRIGGERABLE); otherwise 409. confirmRetrigger is cleared after each send.
}
