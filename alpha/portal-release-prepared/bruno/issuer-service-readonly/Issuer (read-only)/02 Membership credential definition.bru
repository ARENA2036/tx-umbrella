meta {
  name: 02 Membership credential definition
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/credentialdefinitions/{{membershipDefinitionId}}
  body: none
  auth: none
}

headers {
  x-api-key: {{issuerAdminApiKey}}
}

assert {
  res.status: eq 200
}

docs {
  The definition the Portal requests for the Membership credential (membershipCredentialDefinitionId). It runs
  after the BPN credential, so its attestations must also work for new holders.
}
