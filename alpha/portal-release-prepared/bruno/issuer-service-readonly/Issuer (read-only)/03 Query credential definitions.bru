meta {
  name: 03 Query credential definitions
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/credentialdefinitions/query
  body: json
  auth: none
}

headers {
  x-api-key: {{issuerAdminApiKey}}
}

body:json {
  {"offset": 0, "limit": 100}
}

assert {
  res.status: eq 200
}

docs {
  All credential definitions (read-only query). Confirms the exact IDs and credential types
  (BpnCredential, MembershipCredential) and which attestation IDs each one uses.
}
