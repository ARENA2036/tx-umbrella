meta {
  name: 01 BPN credential definition
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/credentialdefinitions/{{bpnDefinitionId}}
  body: none
  auth: none
}

headers {
  x-api-key: {{issuerAdminApiKey}}
}

assert {
  res.status: eq 200
}

docs {
  The definition the Portal requests for the BPN credential (bpnCredentialDefinitionId). Check its
  "attestations" list: those IDs are evaluated before issuance. 404 = the ID does not match the Portal setting.
}
