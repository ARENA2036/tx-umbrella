+
+import {
+  getRetriggerEndUrl,
+  ProgressStatus,
+} from 'features/admin/applicationRequestApiSlice'
+
+export type RetriggerOption = {
+  processStep: string
+  endUrl: string
+}
+
+export type RetriggerPlan = {
+  // A retrigger is offered at all (the backend accepts manual retriggers for FAILED entries only).
+  eligible: boolean
+  // One explicit action per retriggerable step that has an endpoint; never submitted together.
+  options: RetriggerOption[]
+  // Retriggerable steps the frontend has no endpoint for (shown as an actionable message).
+  unmapped: string[]
+}
+
+const NONE: RetriggerPlan = { eligible: false, options: [], unmapped: [] }
+
+export const getRetriggerPlan = (
+  statusId?: string,
+  retriggerableProcessSteps?: string[]
+): RetriggerPlan => {
+  if (statusId !== ProgressStatus.FAILED || !retriggerableProcessSteps?.length)
+    return NONE
+  const options: RetriggerOption[] = []
+  const unmapped: string[] = []
+  new Set(retriggerableProcessSteps).forEach((processStep) => {
+    const endUrl = getRetriggerEndUrl(processStep)
+    if (endUrl) options.push({ processStep, endUrl })
+    else unmapped.push(processStep)
+  })
+  return { eligible: true, options, unmapped }
+}
+
+export type RetriggerErrorKind = 'conflict' | 'unavailable' | 'failed'
+
+export const getRetriggerErrorKind = (error: unknown): RetriggerErrorKind => {
+  const status = (error as { status?: unknown } | null)?.status
+  if (status === 409) return 'conflict'
+  if (status === 'CUSTOM_ERROR') return 'unavailable'
+  return 'failed'
+}
+
+export const getRetriggerErrorDetail = (error: unknown): string | undefined => {
+  const title = (error as { data?: { title?: unknown } } | null)?.data?.title
+  return typeof title === 'string' && title !== '' ? title : undefined
+}
