+import { act, fireEvent, render, screen } from '@testing-library/react'
+import type { ReactNode } from 'react'
+import { ProgressVerificationButton } from '.'
+import {
+  ProgressStatus,
+  StatusType,
+} from 'features/admin/applicationRequestApiSlice'
+
+const mockRetrigger = jest.fn()
+const mockDispatch = jest.fn()
+
+jest.mock('utils/rtkUtil', () => ({
+  apiBaseQuery: () => ({ baseUrl: 'https://portal-backend.test' }),
+}))
+jest.mock('features/admin/applicationRequestApiSlice', () => ({
+  ...jest.requireActual('features/admin/applicationRequestApiSlice'),
+  useApproveChecklistMutation: () => [jest.fn()],
+  useDeclineChecklistMutation: () => [jest.fn()],
+  useRetriggerProcessMutation: () => [mockRetrigger],
+}))
+jest.mock('features/admin/registration/slice', () => ({
+  refreshApplicationRequest: (payload: number) => ({
+    type: 'refreshApplicationRequest',
+    payload,
+  }),
+}))
+jest.mock('react-redux', () => ({
+  ...jest.requireActual('react-redux'),
+  useDispatch: () => mockDispatch,
+}))
+jest.mock('react-i18next', () => ({
+  useTranslation: () => ({ t: (key: string) => key }),
+}))
+// Plain stand-ins for the design-system components (rendering, not styling, is under test).
+jest.mock('@catena-x/portal-shared-components', () => ({
+  Button: ({
+    children,
+    onClick,
+    disabled,
+  }: {
+    children: ReactNode
+    onClick?: () => void
+    disabled?: boolean
+  }) => (
+    <button onClick={onClick} disabled={disabled}>
+      {children}
+    </button>
+  ),
+  CircleProgress: () => <span role="progressbar" />,
+  CustomAccordion: ({
+    items,
+  }: {
+    items: Array<{ id: string; titleElement: ReactNode; children: ReactNode }>
+  }) => (
+    <div>
+      {items.map((item) => (
+        <div key={item.id}>
+          {item.titleElement}
+          {item.children}
+        </div>
+      ))}
+    </div>
+  ),
+  Input: () => <input />,
+  StatusTag: () => null,
+  Typography: ({ children }: { children: ReactNode }) => <div>{children}</div>,
+}))
+
+const APPLICATION_ID = 'c5182556-2376-4afd-9131-15423e8e5e3e'
+const RETRIGGER = 'content.checklistOverlay.buttonRetrigger'
+
+const deferred = () => {
+  let resolve!: () => void
+  let reject!: (e: unknown) => void
+  const promise = new Promise<void>((res, rej) => {
+    resolve = res
+    reject = rej
+  })
+  return { promise, resolve, reject }
+}
+
+const renderButton = (statusId: ProgressStatus, steps: string[]) =>
+  render(
+    <ProgressVerificationButton
+      selectedRequestId={APPLICATION_ID}
+      statusId={statusId}
+      typeId={StatusType.IDENTITY_WALLET}
+      retriggerableProcessSteps={steps}
+    />
+  )
+
+beforeEach(() => {
+  mockRetrigger.mockReset()
+  mockDispatch.mockReset()
+})
+
+describe('ProgressVerificationButton retrigger', () => {
+  it('sends the DID validation retrigger exactly once, even on a double click, and resets loading', async () => {
+    const pending = deferred()
+    mockRetrigger.mockReturnValue({ unwrap: () => pending.promise })
+    renderButton(ProgressStatus.FAILED, ['RETRIGGER_VALIDATE_DID_DOCUMENT'])
+
+    const button = screen.getByRole('button', { name: RETRIGGER })
+    fireEvent.click(button)
+    fireEvent.click(button)
+
+    expect(mockRetrigger).toHaveBeenCalledTimes(1)
+    expect(mockRetrigger).toHaveBeenCalledWith({
+      applicationId: APPLICATION_ID,
+      endUrl: 'retrigger-validate-did',
+    })
+    expect(screen.getByRole('progressbar')).toBeTruthy()
+    expect(screen.queryByRole('button', { name: RETRIGGER })).toBeNull()
+
+    await act(async () => {
+      pending.resolve()
+      await pending.promise
+    })
+
+    expect(screen.queryByRole('progressbar')).toBeNull()
+    expect(screen.getByRole('button', { name: RETRIGGER })).toBeTruthy()
+    expect(mockDispatch).toHaveBeenCalledWith(
+      expect.objectContaining({ type: 'refreshApplicationRequest' })
+    )
+    expect(mockRetrigger).toHaveBeenCalledTimes(1)
+  })
+
+  it.each([
+    ProgressStatus.IN_PROGRESS,
+    ProgressStatus.DONE,
+    ProgressStatus.TO_DO,
+  ])('offers no retrigger while BPNL credential issuance is %s', (status) => {
+    renderButton(status, ['RETRIGGER_REQUEST_BPN_CREDENTIAL'])
+    expect(screen.queryByRole('button', { name: RETRIGGER })).toBeNull()
+    expect(screen.queryByRole('progressbar')).toBeNull()
+    expect(mockRetrigger).not.toHaveBeenCalled()
+  })
+
+  it('handles a 409 once: stops loading, refreshes, explains, never retries', async () => {
+    mockRetrigger.mockReturnValue({
+      unwrap: () =>
+        Promise.reject({ status: 409, data: { title: 'conflict' } }),
+    })
+    renderButton(ProgressStatus.FAILED, ['RETRIGGER_REQUEST_BPN_CREDENTIAL'])
+
+    await act(async () => {
+      fireEvent.click(screen.getByRole('button', { name: RETRIGGER }))
+    })
+
+    expect(mockRetrigger).toHaveBeenCalledTimes(1)
+    expect(mockRetrigger).toHaveBeenCalledWith({
+      applicationId: APPLICATION_ID,
+      endUrl: 'retrigger-bpn-credential',
+    })
+    expect(screen.queryByRole('progressbar')).toBeNull()
+    expect(
+      screen.getByText('content.checklistOverlay.retrigger.conflict')
+    ).toBeTruthy()
+    expect(mockDispatch).toHaveBeenCalledTimes(1)
+  })
+
+  it('resets loading and shows an actionable message when the request fails without a body', async () => {
+    mockRetrigger.mockReturnValue({
+      unwrap: () => Promise.reject({ status: 'FETCH_ERROR', error: 'offline' }),
+    })
+    renderButton(ProgressStatus.FAILED, ['RETRIGGER_VALIDATE_DID_DOCUMENT'])
+
+    await act(async () => {
+      fireEvent.click(screen.getByRole('button', { name: RETRIGGER }))
+    })
+
+    expect(screen.queryByRole('progressbar')).toBeNull()
+    expect(
+      screen.getByText('content.checklistOverlay.retrigger.failed')
+    ).toBeTruthy()
+    expect(screen.getByRole('button', { name: RETRIGGER })).toBeTruthy()
+  })
+
+  it('never submits several alternatives automatically', async () => {
+    mockRetrigger.mockReturnValue({ unwrap: () => Promise.resolve() })
+    renderButton(ProgressStatus.FAILED, [
+      'RETRIGGER_CREATE_IDENTITY_HUB_WALLET',
+      'RETRIGGER_VALIDATE_DID_DOCUMENT',
+    ])
+
+    const buttons = screen.getAllByRole('button', {
+      name: new RegExp(`^${RETRIGGER} \\(`),
+    })
+    expect(buttons).toHaveLength(2)
+    expect(mockRetrigger).not.toHaveBeenCalled()
+
+    await act(async () => {
+      fireEvent.click(
+        screen.getByRole('button', {
+          name: `${RETRIGGER} (RETRIGGER_VALIDATE_DID_DOCUMENT)`,
+        })
+      )
+    })
+    expect(mockRetrigger).toHaveBeenCalledTimes(1)
+    expect(mockRetrigger).toHaveBeenCalledWith({
+      applicationId: APPLICATION_ID,
+      endUrl: 'retrigger-validate-did',
+    })
+  })
+
+  it('shows an actionable message instead of calling /undefined for an unmapped step', () => {
+    renderButton(ProgressStatus.FAILED, ['RETRIGGER_SOMETHING_NEW'])
+    expect(screen.queryByRole('button', { name: RETRIGGER })).toBeNull()
+    expect(
+      screen.getByText('content.checklistOverlay.retrigger.noEndpoint')
+    ).toBeTruthy()
+    expect(mockRetrigger).not.toHaveBeenCalled()
+  })
+})
