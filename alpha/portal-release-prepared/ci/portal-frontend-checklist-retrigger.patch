+import {
+  getRetriggerErrorDetail,
+  getRetriggerErrorKind,
+  getRetriggerPlan,
+} from './retrigger'
+
+jest.mock('utils/rtkUtil', () => ({
+  apiBaseQuery: () => ({ baseUrl: 'https://portal-backend.test' }),
+}))
+
+describe('getRetriggerPlan', () => {
+  it.each(['IN_PROGRESS', 'DONE', 'TO_DO', 'SKIPPED', undefined])(
+    'offers no retrigger while the entry is %p, even if the backend lists retrigger steps',
+    (status) => {
+      expect(
+        getRetriggerPlan(status, ['RETRIGGER_REQUEST_BPN_CREDENTIAL'])
+      ).toEqual({ eligible: false, options: [], unmapped: [] })
+    }
+  )
+
+  it('offers no retrigger for a FAILED entry without retriggerable steps', () => {
+    expect(getRetriggerPlan('FAILED', [])).toMatchObject({ eligible: false })
+    expect(getRetriggerPlan('FAILED', undefined)).toMatchObject({
+      eligible: false,
+    })
+  })
+
+  it('maps a FAILED DID validation to exactly one action', () => {
+    expect(
+      getRetriggerPlan('FAILED', ['RETRIGGER_VALIDATE_DID_DOCUMENT'])
+    ).toEqual({
+      eligible: true,
+      options: [
+        {
+          processStep: 'RETRIGGER_VALIDATE_DID_DOCUMENT',
+          endUrl: 'retrigger-validate-did',
+        },
+      ],
+      unmapped: [],
+    })
+  })
+
+  it('keeps alternatives separate, de-duplicated, and reports unmapped steps', () => {
+    const plan = getRetriggerPlan('FAILED', [
+      'RETRIGGER_CLEARING_HOUSE',
+      'MANUAL_TRIGGER_OVERRIDE_CLEARING_HOUSE',
+      'RETRIGGER_CLEARING_HOUSE',
+      'RETRIGGER_SOMETHING_NEW',
+    ])
+    expect(plan.options.map((o) => o.endUrl)).toEqual([
+      'retrigger-clearinghouse',
+      'override-clearinghouse',
+    ])
+    expect(plan.unmapped).toEqual(['RETRIGGER_SOMETHING_NEW'])
+  })
+})
+
+describe('retrigger error classification', () => {
+  it('classifies 409, a refused unknown endpoint and other failures', () => {
+    expect(getRetriggerErrorKind({ status: 409, data: {} })).toBe('conflict')
+    expect(getRetriggerErrorKind({ status: 'CUSTOM_ERROR', error: 'x' })).toBe(
+      'unavailable'
+    )
+    expect(getRetriggerErrorKind({ status: 500 })).toBe('failed')
+    expect(getRetriggerErrorKind({ status: 'FETCH_ERROR' })).toBe('failed')
+    expect(getRetriggerErrorKind(undefined)).toBe('failed')
+  })
+
+  it('reads a problem title only when it is a non-empty string', () => {
+    expect(getRetriggerErrorDetail({ data: { title: 'Boom' } })).toBe('Boom')
+    expect(getRetriggerErrorDetail({ data: { title: '' } })).toBeUndefined()
+    expect(getRetriggerErrorDetail({ data: 'text' })).toBeUndefined()
+    expect(getRetriggerErrorDetail(null)).toBeUndefined()
+  })
+})
