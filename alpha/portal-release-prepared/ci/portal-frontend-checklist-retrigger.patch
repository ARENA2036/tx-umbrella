+import { configureStore } from '@reduxjs/toolkit'
+import {
+  apiSlice,
+  EndUrlMap,
+  getRetriggerEndUrl,
+  isKnownRetriggerEndUrl,
+  RetriggerableProcessSteps,
+} from './applicationRequestApiSlice'
+
+// No real environment or authentication in unit tests: the base query points at a fixed test host.
+jest.mock('utils/rtkUtil', () => ({
+  apiBaseQuery: () => ({ baseUrl: 'https://portal-backend.test' }),
+}))
+
+const APPLICATION_ID = 'c5182556-2376-4afd-9131-15423e8e5e3e'
+
+const makeStore = () =>
+  configureStore({
+    reducer: { [apiSlice.reducerPath]: apiSlice.reducer },
+    middleware: (getDefault) => getDefault().concat(apiSlice.middleware),
+  })
+
+describe('retrigger endpoint mapping', () => {
+  it('maps the DID validation and IdentityHub wallet retriggers to their backend routes', () => {
+    expect(EndUrlMap.RETRIGGER_VALIDATE_DID_DOCUMENT).toBe(
+      'retrigger-validate-did'
+    )
+    expect(EndUrlMap.RETRIGGER_CREATE_IDENTITY_HUB_WALLET).toBe(
+      'retrigger-create-identity-hub-wallet'
+    )
+    expect(
+      getRetriggerEndUrl(
+        RetriggerableProcessSteps.RETRIGGER_VALIDATE_DID_DOCUMENT
+      )
+    ).toBe('retrigger-validate-did')
+    expect(
+      getRetriggerEndUrl(
+        RetriggerableProcessSteps.RETRIGGER_CREATE_IDENTITY_HUB_WALLET
+      )
+    ).toBe('retrigger-create-identity-hub-wallet')
+  })
+
+  it('has an endpoint for every retriggerable step the UI knows', () => {
+    Object.values(RetriggerableProcessSteps).forEach((step) => {
+      expect(getRetriggerEndUrl(step)).toEqual(expect.any(String))
+    })
+  })
+
+  it('resolves unknown steps and prototype keys to no endpoint', () => {
+    ;[
+      'RETRIGGER_SOMETHING_NEW',
+      '',
+      'toString',
+      '__proto__',
+      'constructor',
+    ].forEach((step) => {
+      expect(getRetriggerEndUrl(step)).toBeUndefined()
+    })
+    expect(isKnownRetriggerEndUrl(undefined)).toBe(false)
+    expect(isKnownRetriggerEndUrl('undefined')).toBe(false)
+    expect(isKnownRetriggerEndUrl('trigger-identity-wallet')).toBe(true)
+  })
+})
+
+describe('retriggerProcess mutation', () => {
+  let fetchMock: jest.SpyInstance
+
+  beforeEach(() => {
+    fetchMock = jest
+      .spyOn(global, 'fetch')
+      .mockResolvedValue(new Response(null, { status: 204 }))
+  })
+
+  afterEach(() => {
+    fetchMock.mockRestore()
+  })
+
+  it('sends exactly one POST to retrigger-validate-did', async () => {
+    const store = makeStore()
+    const result = await store.dispatch(
+      apiSlice.endpoints.retriggerProcess.initiate({
+        applicationId: APPLICATION_ID,
+        endUrl: 'retrigger-validate-did',
+      })
+    )
+    expect('data' in result && result.data).toBe(true)
+    expect(fetchMock).toHaveBeenCalledTimes(1)
+    const request = fetchMock.mock.calls[0][0] as Request
+    expect(request.method).toBe('POST')
+    expect(request.url).toBe(
+      `https://portal-backend.test/api/administration/registration/application/${APPLICATION_ID}/retrigger-validate-did`
+    )
+  })
+
+  it.each([undefined, 'undefined', 'retrigger-anything'])(
+    'never calls the backend for endpoint %p',
+    async (endUrl) => {
+      const store = makeStore()
+      const result = await store.dispatch(
+        apiSlice.endpoints.retriggerProcess.initiate({
+          applicationId: APPLICATION_ID,
+          endUrl,
+        })
+      )
+      expect('error' in result && result.error).toMatchObject({
+        status: 'CUSTOM_ERROR',
+      })
+      expect(fetchMock).not.toHaveBeenCalled()
+    }
+  )
+
+  it('surfaces a 409 as an error without retrying', async () => {
+    fetchMock.mockResolvedValue(
+      new Response(JSON.stringify({ title: 'conflict' }), {
+        status: 409,
+        headers: { 'content-type': 'application/json' },
+      })
+    )
+    const store = makeStore()
+    const result = await store.dispatch(
+      apiSlice.endpoints.retriggerProcess.initiate({
+        applicationId: APPLICATION_ID,
+        endUrl: 'retrigger-bpn-credential',
+      })
+    )
+    expect('error' in result && result.error).toMatchObject({ status: 409 })
+    expect(fetchMock).toHaveBeenCalledTimes(1)
+  })
+})
