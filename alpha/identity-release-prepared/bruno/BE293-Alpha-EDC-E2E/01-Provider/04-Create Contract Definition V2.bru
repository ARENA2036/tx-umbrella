meta {
  name: 04-Create Contract Definition V2
  type: http
  seq: 4
}

post {
  url: {{Provider}}/v3/contractdefinitions
  body: json
  auth: apikey
}

headers {
  Content-Type: application/json
}

auth:apikey {
  key: X-Api-Key
  value: {{Provider_Api_Key}}
  placement: header
}

body:json {
  {
    "@context": {
      "edc": "https://w3id.org/edc/v0.0.1/ns/"
    },
    "@id": "be293-e2e-contract-2",
    "@type": "ContractDefinition",
    "accessPolicyId": "be293-e2e-access-1",
    "contractPolicyId": "be293-e2e-contract-policy-2",
    "assetsSelector": [
      {
        "@type": "CriterionDto",
        "operandLeft": "https://w3id.org/edc/v0.0.1/ns/id",
        "operator": "=",
        "operandRight": "be293-e2e-asset-1"
      }
    ]
  }
}

tests {
  // 200 + IdResponse on the first run; 409 when the object already exists (re-run): both mean "present".
  test("created (200) or already present (409)", function () {
    expect([200, 409]).to.include(res.getStatus());
  });
  test("IdResponse carries the expected @id", function () {
    if (res.getStatus() === 200) {
      expect(res.getBody()["@id"]).to.equal("be293-e2e-contract-2");
    }
  });
}
