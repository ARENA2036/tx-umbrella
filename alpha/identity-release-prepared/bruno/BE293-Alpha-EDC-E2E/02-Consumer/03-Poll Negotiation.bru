meta {
  name: 03-Poll Negotiation
  type: http
  seq: 3
}

get {
  url: {{Consumer}}/v3/contractnegotiations/{{negotiationId}}
  body: none
  auth: apikey
}

auth:apikey {
  key: X-Api-Key
  value: {{Consumer_Api_Key}}
  placement: header
}

script:post-response {
  // contract negotiation is ASYNCHRONOUS: poll until a terminal state instead of trusting one call. A TERMINATED contract negotiation cannot
  // be resumed; a re-run must start a new one from the POST before this request.
  const axios = require("axios");
  const url = req.getUrl();
  const headers = { "X-Api-Key": bru.getEnvVar("Consumer_Api_Key") };
  let body = res.getBody();
  for (let i = 0; i < 40 && !["FINALIZED", "TERMINATED"].includes(body.state); i++) {
    await bru.sleep(3000);
    body = (await axios.get(url, { headers })).data;
  }
  bru.setVar("negotiationState", body.state);
  if (body.contractAgreementId) { bru.setVar("agreementId", body.contractAgreementId); }
}

tests {
  test("negotiation FINALIZED with an agreement", function () {
    expect(bru.getVar("negotiationState"), "TERMINATED cannot be resumed: start a new negotiation (02)").to.equal("FINALIZED");
    expect(bru.getVar("agreementId")).to.be.a("string").and.not.empty;
  });
}
